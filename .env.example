# Local development environment for raccounting.
#
# Copy this file to .env. Both docker-compose (for the MariaDB container) and the app itself (via
# godotenv, see config.LoadEnv) read it automatically — no exporting needed:
#
#   docker compose up -d
#   go run ./cmd/raccounting

# DB_DRIVER selects the backend: mysql (default, matches docker-compose above), postgres, or sqlite.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=raccounting
DB_PASSWORD=raccounting
DB_NAME=raccounting
# Used by sqlite only — path to the database file, created automatically (along with its parent
# directory) on first run.
# DB_SQLITE_PATH=./data/raccounting.db

# Connection pool tuning — all optional, shown here at their defaults. DB_MAX_OPEN_CONNS is ignored
# for sqlite (always 1 — SQLite doesn't tolerate concurrent writers); DB_MAX_IDLE_CONNS is ignored
# for sqlite entirely; DB_CONN_TIMEOUT (dial timeout for the initial TCP connection) applies to mysql
# only.
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m
# DB_CONN_TIMEOUT=5s

# Everything below is optional and shown at its default. A value that is set but malformed
# (PORT=http, COOKIE_SECURE=yes, LOG_CONSOLE_LEVEL=verbose) fails at startup rather than silently
# falling back.
PORT=8080

# Send the session cookie over HTTPS only — turn this on in production.
COOKIE_SECURE=false

# Credentials for the demo user seeded on first run (only when the users table is still empty).
DEMO_USERNAME=user
DEMO_PASSWORD=pass

# Logs go to two independent destinations, each with its own minimum severity: debug, info, warn or
# error (case insensitive).
#
# The console goes to stdout as plain text, and defaults to warn — quiet enough that routine
# operation doesn't bury the terminal.
LOG_CONSOLE_LEVEL=warn
#
# The file gets JSON instead, for a log aggregator to ingest. It is off until LOG_FILE_PATH is set;
# the path is created along with any missing parent directories, and appended to across restarts.
# Nothing rotates it, so in production point it somewhere logrotate can see.
# LOG_FILE_PATH=./logs/raccounting.log
# LOG_FILE_LEVEL=info
